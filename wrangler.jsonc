{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xframe-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-19",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./docs/examples/resume",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "INVITE_CONTEXTS",
      "id": "863e722f895f4794a2e60c600751eb92"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:8000,http://localhost:3000,http://127.0.0.1:5500,https://resume.jvb127.workers.dev,https://xframe-ai.jvb127.workers.dev",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "GEMINI_TTS_MODEL": "gemini-3.1-flash-tts-preview",
    "GEMINI_TTS_FALLBACK_MODEL": "gemini-2.5-flash-preview-tts",
    "GEMINI_LIVE_MODEL": "gemini-2.5-flash-native-audio-preview-12-2025",
    "MAX_INPUT_CHARS": "40000",
    "MAX_OUTPUT_TOKENS": "2048",
    "INVITE_MAX_CALLS": "20",
    "INVITE_MAX_CONTEXT_CHARS": "500",
    "INVITE_MAX_KV_CONTEXT_CHARS": "5000",
    "INVITE_CONTEXT_DIR": "contexts",
    "LIVE_TOKEN_EXPIRE_MS": "1800000",
    "LIVE_TOKEN_NEW_SESSION_EXPIRE_MS": "60000"
  },
  "secrets": {
    "required": ["GEMINI_API_KEY", "INVITE_SIGNING_SECRET", "INVITE_ADMIN_SECRET"]
  }
}
