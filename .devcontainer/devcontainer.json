{
  "name": "xFrame.ai",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "runArgs": ["--privileged", "--env-file", "${localEnv:HOME}/.devcontainer/devcontainer.env"],
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
  "forwardPorts": [
    "${localEnv:XFORM_PORT:42042}"
  ],
  "appPort": [
    "${localEnv:XFORM_PORT:42042}:${localEnv:XFORM_PORT:42042}"
  ],
  "portsAttributes": {
    "${localEnv:XFORM_PORT:42042}": {
      "label": "xForm lab UI",
      "onAutoForward": "notify"
    },
    "default": {
      "label": "xForm lab UI",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "XFRAME_SKILLS_ROOT": "/workspaces/${localWorkspaceFolderBasename}/.cursor/skills",
    "XFORM_WORKSPACE": "/tmp/xform-ws",
    "XFORM_PORT": "${localEnv:XFORM_PORT:42042}",
    "GEMINI_API_KEY1": "${localEnv:GEMINI_API_KEY1}",
    "GEMINI_API_KEY2": "${localEnv:GEMINI_API_KEY2}",
    "GEMINI_API_KEY3": "${localEnv:GEMINI_API_KEY3}",
    "OPENROUTER_API_KEY1": "${localEnv:OPENROUTER_API_KEY1}",
    "OPENROUTER_API_KEY2": "${localEnv:OPENROUTER_API_KEY2}",
    "OPENROUTER_API_KEY3": "${localEnv:OPENROUTER_API_KEY3}"
  },
  "postStartCommand": "mkdir -p .cursor && echo '[xFrame.ai] refreshing skills' >&2 && /usr/local/bin/install-xFrame-ai-skills.sh --aliases >&2",
  "customizations": {
    "vscode": {
      "extensions": [
        "ritwickdey.LiveServer"
      ]
    }
  }
}
