---
extends: black-white
typography:
  title: { size: 3, lineHeight: 1.04 }
  body: { size: 1.18, lineHeight: 1.4 }
spacing:
  contentPaddingX: 2.4
  contentPaddingY: 1.8
  contentGap: 0.72
---

````css
/* Canadian Declaration — balanced, declaration-style two-column treatment. */
#xframe .segment[data-layout="horizontal-split"] .horizontal-split-left,
#xframe .segment[data-layout="horizontal-split"] .horizontal-split-right {
  justify-content: flex-start;
  gap: 0.68rem;
  overflow: visible;
}

#xframe .segment[data-layout="horizontal-split"] .horizontal-split-left > h1 {
  margin-bottom: 0.35rem;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 3rem;
  line-height: 1.04;
  letter-spacing: -0.025em;
}

#xframe .segment[data-layout="horizontal-split"] :is(.horizontal-split-left, .horizontal-split-right) > p {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.18rem;
  line-height: 1.4;
}

#xframe .declaration-logos {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.75rem;
  height: 4.5rem;
}

#xframe .declaration-logo {
  width: auto;
  height: 4.5rem;
  border-radius: 0.3rem;
}

#xframe .segment[data-layout="horizontal-split"] .horizontal-split-right > :is(img, figure) {
  flex: 1 1 11rem;
  min-height: 9.5rem;
}

#xframe #independent_keystone {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
````
