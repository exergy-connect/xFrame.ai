---
---
@style base
  accent: "#000000"
  fg: "#000000"
  bg: "#ffffff"
  surfaceBg: "#ffffff"
  muted: "#555555"
  border: "#000000"
  codeBg: "#f2f2f2"
  boxShadow: "none"

````css
#xframe[data-theme="canadian-monochrome"] {
  color: #000;
  background: #fff;
}

#xframe[data-theme="canadian-monochrome"] .segment {
  color: #000;
  background: #fff;
}

#xframe[data-theme="canadian-monochrome"] img,
#xframe[data-theme="canadian-monochrome"] svg,
#xframe[data-theme="canadian-monochrome"] video,
#xframe[data-theme="canadian-monochrome"] canvas {
  filter: grayscale(1) !important;
}
````
