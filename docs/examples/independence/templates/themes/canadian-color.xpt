---
---
@style base
  accent: "#d80621"
  fg: "#171717"
  bg: "#fffaf2"
  surfaceBg: "#fffaf2"
  muted: "#5e2028"
  border: "#d8a0a8"
  codeBg: "#fff0e8"
  boxShadow: "0 1rem 2.4rem rgba(72, 8, 18, 0.18)"

````css
#xframe[data-theme="canadian-color"] {
  color: var(--fg);
  background:
    radial-gradient(circle at 12% 88%, rgba(216, 6, 33, 0.14), transparent 32%),
    linear-gradient(135deg, #fffdf8, #fff4e8);
}

#xframe[data-theme="canadian-color"] .segment {
  color: var(--fg);
  background: transparent;
}

#xframe[data-theme="canadian-color"] img,
#xframe[data-theme="canadian-color"] svg,
#xframe[data-theme="canadian-color"] video,
#xframe[data-theme="canadian-color"] canvas {
  filter: none !important;
}

#xframe[data-theme="canadian-color"] #canadian-flag-reveal {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, 0) scale(1);
  transition-delay: 0s;
}

#xframe[data-theme="canadian-color"] .horizontal-split-footer {
  border-top-color: rgba(216, 6, 33, 0.45);
}
````
