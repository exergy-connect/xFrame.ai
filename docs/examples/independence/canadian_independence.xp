```javascript
document.addEventListener("ended", (event) => {
  const audio = event.target;
  if (!(audio instanceof HTMLAudioElement) || !audio.matches("audio[data-narrative-audio]")) return;
  const theme = "canadian-color";
  const root = document.getElementById("xframe");
  if (!root) return;
  root.dataset.theme = theme;
  root.querySelectorAll(".segment").forEach((slide) => { slide.dataset.theme = theme; });
  document.documentElement.dataset.theme = theme;
}, true);
```
