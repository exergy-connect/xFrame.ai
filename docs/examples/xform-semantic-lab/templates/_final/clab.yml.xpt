---
# Lab package — Containerlab topology plus per-node device configs.
# Body is an xForm segment stream; each segment sets `_document._output`.
---
_document:
  _output:
    _basename: clab
    _extension: yml
===
name: {{ name }}
prefix: ""

mgmt:
  network: {{ addressing.mgmt.network | default('lab_mgmt') }}
  ipv4-subnet: {{ addressing.mgmt.ipv4 | default('192.168.121.0/24') }}

topology:
  nodes:
{% for nname, node in addressed.nodes | dictsort %}
    {{ nname }}:
      kind: {{ kind }}
      image: {{ image }}
      runtime: {{ runtime }}
{% if node.mgmt and node.mgmt.ipv4 %}
      mgmt-ipv4: {{ node.mgmt.ipv4 }}
{% endif %}
      binds:
        - {{ 'config/' ~ nname ~ '.conf' }}:{{ config_path }}
        - {{ 'config/' ~ nname ~ '-initialize.sh' }}:{{ init_path }}
      entrypoint: /bin/bash
      cmd: {{ init_path }}
{% endfor %}

  links:
{% for link in addressed.links %}
  - endpoints:
{% for iface in link.interfaces %}
      - "{{ iface.node }}:{{ iface.ifname }}"
{% endfor %}
{% endfor %}
{% for nname, node in addressed.nodes | dictsort %}
---
_document:
  _output:
    _basename: config/{{ nname }}
    _extension: conf
===
{{ include("templates/devices/" ~ node.device ~ ".xpt#1", with={"node": node, "name": nname}) }}
{% endfor %}
{% for nname, node in addressed.nodes | dictsort %}
---
_document:
  _output:
    _basename: config/{{ nname }}-initialize
    _extension: sh
===
{{ include("templates/devices/" ~ node.device ~ ".xpt#2", with={"node": node, "name": nname}) }}
{% endfor %}
---
_document:
  _output:
    _basename: lab
    _extension: sh
===
#!/usr/bin/env bash
# {{ name }} — interactive lab CLI (generated by xForm semantic-lab-fw)
#
# Usage:
#   ./lab.sh              # start a lab-aware bash subshell
#   source lab.sh         # load helpers into the current shell
#
# Then:
#   dut                   # interactive vtysh on dut
#   dut show bgp summary  # one-shot vtysh command
#   dut shell             # bash inside the container
#   nodes / status        # list nodes / containerlab inspect
#   Tab-complete node names and common vtysh verbs

# If executed (not sourced), open a dedicated interactive bash with this rcfile.
if [[ "${BASH_SOURCE[0]-}" == "${0}" ]]; then
  exec bash --rcfile "${BASH_SOURCE[0]}"
fi

_LAB_NAME="{{ name }}"
_LAB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_LAB_TOPOLOGY="${_LAB_DIR}/clab.yml"
_LAB_NODES=({% for nname, node in addressed.nodes | dictsort %}{{ nname }} {% endfor %})

# Avoid re-defining helpers if sourced twice.
if [[ -n "${_LAB_CLI_LOADED:-}" ]]; then
  return 0 2>/dev/null || true
fi
_LAB_CLI_LOADED=1

_lab_docker_tty() {
  if [[ -t 0 && -t 1 ]]; then
    printf '%s' "-it"
  else
    printf '%s' "-i"
  fi
}

_lab_vtysh() {
  local node=${1:?node required}
  shift
  local tty
  tty="$(_lab_docker_tty)"
  # shellcheck disable=SC2086
  if [[ $# -eq 0 ]]; then
    docker exec ${tty} "$node" vtysh
  elif [[ $1 == shell || $1 == bash ]]; then
    shift
    docker exec ${tty} "$node" bash -il "$@"
  elif [[ $1 == -c ]]; then
    docker exec ${tty} "$node" vtysh "$@"
  else
    docker exec ${tty} "$node" vtysh -c "$*"
  fi
}

{% for nname, node in addressed.nodes | dictsort %}
{{ nname }}() { _lab_vtysh "{{ nname }}" "$@"; }
{% endfor %}

nodes() {
  printf '%s\n' "${_LAB_NODES[@]}"
}

status() {
  if command -v containerlab >/dev/null 2>&1; then
    containerlab inspect -t "${_LAB_TOPOLOGY}"
  else
    local node
    for node in "${_LAB_NODES[@]}"; do
      docker ps --filter "name=^${node}$"
    done
  fi
}

_lab_complete_node_cmds() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  local verbs="show configure write shell bash -c"
  if [[ ${COMP_CWORD} -eq 1 ]]; then
    COMPREPLY=($(compgen -W "${verbs}" -- "${cur}"))
  else
    COMPREPLY=()
  fi
}

{% for nname, node in addressed.nodes | dictsort %}
complete -o default -F _lab_complete_node_cmds {{ nname }}
{% endfor %}

# Friendly prompt while this environment is active.
PS1="(${_LAB_NAME}) \[\e[1;32m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\$ "
export PS1

cat <<EOF
Lab ${_LAB_NAME} CLI ready (nodes: ${_LAB_NODES[*]})
  <node>                  interactive vtysh
  <node> show …           one-shot vtysh command
  <node> shell            bash in container
  nodes | status          list nodes / lab status
EOF
...
