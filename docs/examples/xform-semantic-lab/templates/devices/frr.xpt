---
# FRR container defaults (clab subset).
kind: linux
image: quay.io/frrouting/frr:10.6.1
runtime: docker
mgmt_if: eth0
config_path: /etc/frr/frr.conf
init_path: /etc/config/initialize.sh
interface_name: eth{ifindex}
---
! {{ node.name }} — FRR configuration (generated by xForm semantic-lab-fw)
hostname {{ node.name }}
!
ip forwarding
!
{% for iface in node.interfaces | default([]) %}
interface {{ iface.ifname }}
{% if iface.ipv4 %}
 ip address {{ iface.ipv4 }}
{% endif %}
{% if iface.ipv6 %}
 ipv6 address {{ iface.ipv6 }}
{% endif %}
!
{% endfor %}
{% for mod in node.module | default([]) %}
{{ include("templates/modules/" ~ mod ~ ".xpt#1", with={"node": node}) }}
{% endfor %}
...
---
#!/bin/bash
# {{ node.name }} — FRR initialize (generated by xForm semantic-lab-fw)
set -e
set -x
#
# Create bash profile script
#
cat <<'SCRIPT' >/root/.bash_profile
#!/bin/bash
#
export PS1="\h(bash)# "
echo
echo "Use vtysh to connect to FRR daemon"
echo
SCRIPT
#
# Forwarding (also set via vtysh below; set early for data-plane interfaces)
#
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1
#
# Management VRF — move eth0 into mgmt so data-plane routing stays separate
#
if grep vrf /proc/modules && ip link show dev eth0; then
  def_nh=$(ip route list default|awk '{ print $3 }')
  if [ ! -e /sys/devices/virtual/net/mgmt ]; then
    ip link add mgmt type vrf table 42
  fi
  ip link set mgmt up
  sysctl -qw net.ipv6.conf.eth0.keep_addr_on_down=1
  ip link set eth0 master mgmt
  if [[ -n "$def_nh" ]]; then
    ip route add 0.0.0.0/0 vrf mgmt via $def_nh
  fi
fi
#
# Send ARP requests from a sane source IP address
#
sysctl -w net.ipv4.conf.all.arp_announce=2
#
# Create missing loopback/stub as dummy (do NOT create ethN — Containerlab attaches those)
#
{% for iface in node.interfaces | default([]) if iface.type in ['loopback', 'stub'] %}
if [ ! -e /sys/class/net/{{ iface.ifname }} ]; then
  if [ ! -e /sys/devices/virtual/net/{{ iface.ifname }} ]; then
    ip link add {{ iface.ifname }} type dummy
    ip link set dev {{ iface.ifname }} up
  fi
fi
{% endfor %}
#
# Wait for Containerlab data-plane interfaces before sysctl / addressing
#
{% for iface in node.interfaces | default([]) if iface.type not in ['loopback', 'stub'] %}
for _ in $(seq 1 50); do
  [ -e /sys/class/net/{{ iface.ifname }} ] && break
  sleep 0.1
done
[ -e /sys/class/net/{{ iface.ifname }} ] || { echo "interface {{ iface.ifname }} not present"; exit 1; }
{% endfor %}
#
# Linux interface sysctl: disable IPv6 on IPv4-only interfaces, then up
#
{% for iface in node.interfaces | default([]) %}
ip link set {{ iface.ifname }} down
{% if iface.ipv6 is not defined or not iface.ipv6 %}
sysctl -qw net/ipv6/conf/{{ iface.ifname }}/disable_ipv6=1
{% else %}
sysctl -qw net/ipv6/conf/{{ iface.ifname }}/keep_addr_on_down=1
sysctl -qw net/ipv6/conf/{{ iface.ifname }}/autoconf=0
sysctl -qw net/ipv6/conf/{{ iface.ifname }}/accept_ra=0
sysctl -qw net/ipv6/conf/{{ iface.ifname }}/addr_gen_mode=3
{% endif %}
{% if iface.mtu is defined %}
ip link set dev {{ iface.ifname }} mtu {{ iface.mtu }}
{% endif %}
ip link set {{ iface.ifname }} up
{% endfor %}
#
# FRR daemons — baseline all optional daemons off; modules enable what they need
#
cat >/etc/frr/daemons <<'DAEMONS'
# Generated by xForm semantic-lab-fw (Netlab-style FRR daemons)
bgpd=no
ospfd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd=no
fabricd=no
vrrpd=no
pathd=no
vtysh_enable=yes
zebra_options="  -A 127.0.0.1 -s 90000000"
bgpd_options="   -A 127.0.0.1"
ospfd_options="  -A 127.0.0.1"
ospf6d_options=" -A ::1"
ripd_options="   -A 127.0.0.1"
ripngd_options=" -A ::1"
isisd_options="  -A 127.0.0.1"
pimd_options="   -A 127.0.0.1"
ldpd_options="   -A 127.0.0.1"
nhrpd_options="  -A 127.0.0.1"
eigrpd_options=" -A 127.0.0.1"
babeld_options=" -A 127.0.0.1"
sharpd_options=" -A 127.0.0.1"
pbrd_options="   -A 127.0.0.1"
staticd_options="-A 127.0.0.1"
bfdd_options="   -A 127.0.0.1"
fabricd_options="-A 127.0.0.1"
vrrpd_options="  -A 127.0.0.1"
pathd_options="  -A 127.0.0.1"
frr_profile="datacenter"
{% for mod in node.module | default([]) %}
{{ include("templates/modules/" ~ mod ~ ".xpt#2", with={"node": node}) }}
{% endfor %}
DAEMONS
#
# vtysh + log directory
#
echo "service integrated-vtysh-config" >/etc/frr/vtysh.conf
mkdir -p /var/log/frr && chown frr:frr /var/log/frr
#
# Initial FRR config applied via vtysh after daemons are up
#
cat >/tmp/config <<'CONFIG'
hostname {{ node.name }}
!
log file /var/log/frr/frr.log informational
!
ip forwarding
ipv6 forwarding
!
vrf mgmt
 exit-vrf
!
frr defaults datacenter
!
{% for iface in node.interfaces | default([]) %}
interface {{ iface.ifname }}
 no shutdown
{% if iface.ipv4 %}
 ip address {{ iface.ipv4 }}
{% endif %}
{% if iface.ipv6 %}
 ipv6 address {{ iface.ipv6 }}
{% endif %}
!
{% endfor %}
do write
CONFIG
#
# Start FRR (reads /etc/frr/daemons), wait for settle, apply initial config
#
/usr/lib/frr/docker-start &
sleep 1
vtysh -f /tmp/config
wait
...
